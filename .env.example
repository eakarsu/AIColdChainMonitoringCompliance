NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/cold_chain_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cold_chain_db
DB_USER=app_user
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters
DEVICE_SIGNING_SECRET=replace-with-an-independent-32-character-secret
OPENROUTER_API_KEY=
DEMO_ADMIN_PASSWORD=
DEMO_VIEWER_PASSWORD=
DEMO_MANAGER_PASSWORD=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
